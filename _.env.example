# Copy this file to .env and fill in the real values.

# Find this URL in the Neon console: Settings > Better Auth > Auth URL
# (the value shown there, something like https://ep-xxxxx.c-x.us-east-x.aws.neonauth.c-x.us-east-x.aws)
VITE_NEON_AUTH_URL=
NEON_AUTH_BASE_URL=   # same value as above, used server-side (api/_lib/verify-auth.js)

# Your Neon Postgres connection string (Dashboard > Connect)
DATABASE_URL=

# For profile picture uploads (api/_lib/neon-bucket.js), needed in addition
# to DATABASE_URL since bucket presigning uses Neon's account-level API,
# not the database connection:
NEON_API_KEY=         # generate in Neon console: Account Settings > API Keys
NEON_PROJECT_ID=       # e.g. noisy-cloud-03743917 (from your Project overview page)
NEON_BRANCH_ID=        # e.g. br-square-glitter-b48um6cz (from your Project overview page)
NEON_BUCKET_NAME=numora-profile-pictures

# For the admin dashboard (/admin.html) — pick your own password, this is
# never shown anywhere, just checked against what you type on that page.
ADMIN_PASSWORD=

# For monthly push notifications — create a free account at onesignal.com,
# create a new "Web" app there, and copy these two values from its Settings:
VITE_ONESIGNAL_APP_ID=   # Settings > Keys & IDs > OneSignal App ID (same value as below, exposed to the browser)
ONESIGNAL_APP_ID=        # same App ID again, used server-side in the cron job
ONESIGNAL_API_KEY=       # Settings > Keys & IDs > REST API Key — keep this secret, never VITE_-prefixed
